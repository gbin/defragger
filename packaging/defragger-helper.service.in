[Unit]
Description=Defragger privileged filesystem helper

[Service]
Type=dbus
BusName=net.gootz.defragger.Helper
ExecStart=@CMAKE_INSTALL_FULL_LIBEXECDIR@/defragger-helper
User=root
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_FOWNER CAP_SYS_RAWIO CAP_SYS_ADMIN
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictRealtime=yes
